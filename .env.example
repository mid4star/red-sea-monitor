# Red Sea Monitor - Environment Configuration

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/red_sea_monitor?schema=public"

# App & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Red Sea Monitor"
AUTH_SECRET="red-sea-monitor-secret-key-32-chars-long-2026"
NEXTAUTH_URL="http://localhost:3000"

# Feature Flags (v1 Enquiry Protocol)
NEXT_PUBLIC_STORE_ENABLED="false"


# Optional Cloudflare Turnstile (Anti-spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional Resend (Transactional emails)
RESEND_API_KEY=""

# Optional Storage (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="red-sea-monitor"
